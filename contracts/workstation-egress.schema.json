{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mindclade.internal/workstation-egress.schema.json",
  "type": "object",
  "required": [
    "$schema",
    "blockers",
    "egress_baseline",
    "evidence",
    "rejected_designs",
    "schema_version",
    "selected_design",
    "status",
    "workstation"
  ],
  "properties": {
    "$schema": {"const": "./workstation-egress.schema.json"},
    "schema_version": {"const": 1},
    "status": {"enum": ["blocked", "qualifying", "qualified", "activated"]},
    "blockers": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "egress_baseline": {
      "type": "object",
      "required": [
        "deny_destination",
        "deny_priority",
        "deny_rule",
        "environments",
        "reviewed_destinations",
        "unit"
      ],
      "properties": {
        "deny_destination": {"const": "0.0.0.0/0"},
        "deny_priority": {"const": 65000},
        "deny_rule": {"const": "deny-egress-default"},
        "environments": {"const": ["development", "production", "staging"]},
        "reviewed_destinations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"},
          "not": {"contains": {"const": "0.0.0.0/0"}}
        },
        "unit": {"const": "3-networks/development/firewall-baseline"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "apt_install_from_internal_source",
        "idle_timer_installed",
        "nix_present_without_public_fetch",
        "provisioning_completes",
        "remote_upstream_serves_debian",
        "vpc_sc_enforced_path_qualified"
      ],
      "properties": {
        "apt_install_from_internal_source": {"type": "boolean"},
        "idle_timer_installed": {"type": "boolean"},
        "nix_present_without_public_fetch": {"type": "boolean"},
        "provisioning_completes": {"type": "boolean"},
        "remote_upstream_serves_debian": {"type": "boolean"},
        "vpc_sc_enforced_path_qualified": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "rejected_designs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["blocking_gap", "id", "reason"],
        "properties": {
          "blocking_gap": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "reason": {"type": "string", "minLength": 40, "maxLength": 800}
        },
        "additionalProperties": false
      }
    },
    "selected_design": {
      "type": "object",
      "required": ["adds_egress_destination", "components", "id", "implemented", "summary"],
      "properties": {
        "adds_egress_destination": {"const": false},
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["id", "requires_module_change", "summary"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
              "requires_module_change": {
                "type": ["string", "null"],
                "pattern": "^infra/terraform/modules/[a-z0-9_]+$"
              },
              "summary": {"type": "string", "minLength": 40, "maxLength": 800}
            },
            "additionalProperties": false
          }
        },
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "implemented": {"type": "boolean"},
        "summary": {"type": "string", "minLength": 40, "maxLength": 800}
      },
      "additionalProperties": false
    },
    "workstation": {
      "type": "object",
      "required": [
        "blocked_steps",
        "module",
        "module_release",
        "provisioning_completes",
        "startup_script_override_available",
        "unit"
      ],
      "properties": {
        "blocked_steps": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["hosts", "id", "step"],
            "properties": {
              "hosts": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "maxLength": 253,
                  "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])$"
                }
              },
              "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
              "step": {"type": "string", "minLength": 4, "maxLength": 200}
            },
            "additionalProperties": false
          }
        },
        "module": {"const": "infra/terraform/modules/workstation"},
        "module_release": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "provisioning_completes": {"type": "boolean"},
        "startup_script_override_available": {"const": false},
        "unit": {"const": "5-workloads/development/workstation"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "blocked"}}},
      "then": {
        "properties": {
          "blockers": {"minItems": 1},
          "evidence": {
            "properties": {
              "apt_install_from_internal_source": {"const": false},
              "idle_timer_installed": {"const": false},
              "nix_present_without_public_fetch": {"const": false},
              "provisioning_completes": {"const": false},
              "remote_upstream_serves_debian": {"const": false},
              "vpc_sc_enforced_path_qualified": {"const": false}
            }
          },
          "selected_design": {"properties": {"implemented": {"const": false}}},
          "workstation": {
            "properties": {
              "blocked_steps": {"minItems": 1},
              "provisioning_completes": {"const": false}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "qualifying"}}},
      "then": {
        "properties": {
          "blockers": {"minItems": 1},
          "selected_design": {"properties": {"implemented": {"const": true}}},
          "workstation": {"properties": {"provisioning_completes": {"const": false}}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["qualified", "activated"]}}},
      "then": {
        "properties": {
          "blockers": {"maxItems": 0},
          "evidence": {
            "properties": {
              "apt_install_from_internal_source": {"const": true},
              "idle_timer_installed": {"const": true},
              "nix_present_without_public_fetch": {"const": true},
              "provisioning_completes": {"const": true},
              "remote_upstream_serves_debian": {"const": true},
              "vpc_sc_enforced_path_qualified": {"const": true}
            }
          },
          "selected_design": {"properties": {"implemented": {"const": true}}},
          "workstation": {"properties": {"blocked_steps": {"maxItems": 0}}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "qualified"}}},
      "then": {
        "properties": {
          "workstation": {"properties": {"provisioning_completes": {"const": false}}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "activated"}}},
      "then": {
        "properties": {
          "workstation": {"properties": {"provisioning_completes": {"const": true}}}
        }
      }
    }
  ],
  "additionalProperties": false
}
