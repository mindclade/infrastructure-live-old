{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mindclade.internal/workstation-egress.schema.json",
  "type": "object",
  "required": ["$schema", "blockers", "egress_baseline", "evidence", "rejected_designs", "releases", "schema_version", "selected_design", "status", "workstation"],
  "properties": {
    "$schema": {"const": "./workstation-egress.schema.json"},
    "schema_version": {"const": 2},
    "status": {"enum": ["qualifying", "qualified", "activated"]},
    "blockers": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "egress_baseline": {
      "type": "object",
      "required": ["deny_destination", "deny_priority", "deny_rule", "environments", "reviewed_destinations", "unit"],
      "properties": {
        "deny_destination": {"const": "0.0.0.0/0"},
        "deny_priority": {"const": 65000},
        "deny_rule": {"const": "deny-egress-default"},
        "environments": {"const": ["development", "production", "staging"]},
        "reviewed_destinations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"},
          "not": {"contains": {"const": "0.0.0.0/0"}}
        },
        "unit": {"const": "3-networks/development/firewall-baseline"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["compute_image_applied", "first_boot_qualified", "idle_shutdown_observed", "image_contract_source_validated", "rollback_image_booted", "runtime_fetches_absent", "source_publication_create_only", "vpc_sc_cache_path_qualified"],
      "properties": {
        "compute_image_applied": {"type": "boolean"},
        "first_boot_qualified": {"type": "boolean"},
        "idle_shutdown_observed": {"type": "boolean"},
        "image_contract_source_validated": {"type": "boolean"},
        "rollback_image_booted": {"type": "boolean"},
        "runtime_fetches_absent": {"type": "boolean"},
        "source_publication_create_only": {"type": "boolean"},
        "vpc_sc_cache_path_qualified": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "rejected_designs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["blocking_gap", "id", "reason"],
        "properties": {
          "blocking_gap": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "reason": {"type": "string", "minLength": 40, "maxLength": 800}
        },
        "additionalProperties": false
      }
    },
    "releases": {
      "type": "object",
      "required": ["bootstrapContract", "terraformModules", "workflowContract"],
      "properties": {
        "bootstrapContract": {"const": "1.6.0"},
        "terraformModules": {"const": "v0.4.0"},
        "workflowContract": {"const": "v5.0.0"}
      },
      "additionalProperties": false
    },
    "selected_design": {
      "type": "object",
      "required": ["adds_egress_destination", "components", "id", "implemented", "summary"],
      "properties": {
        "adds_egress_destination": {"const": false},
        "components": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["id", "source_path", "summary"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
              "source_path": {"type": "string", "minLength": 8, "maxLength": 160},
              "summary": {"type": "string", "minLength": 40, "maxLength": 800}
            },
            "additionalProperties": false
          }
        },
        "id": {"const": "immutable-nixos-image-without-new-egress"},
        "implemented": {"const": true},
        "summary": {"type": "string", "minLength": 40, "maxLength": 800}
      },
      "additionalProperties": false
    },
    "workstation": {
      "type": "object",
      "required": ["activated", "image_unit", "module", "module_release", "source_provisioning_complete", "startup_script_override_available", "unit"],
      "properties": {
        "activated": {"type": "boolean"},
        "image_unit": {"const": "5-workloads/development/workstation-image"},
        "module": {"const": "infra/terraform/modules/workstation"},
        "module_release": {"const": "v0.4.0"},
        "source_provisioning_complete": {"const": true},
        "startup_script_override_available": {"const": false},
        "unit": {"const": "5-workloads/development/workstation"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "qualifying"}}},
      "then": {"properties": {"blockers": {"minItems": 1}, "workstation": {"properties": {"activated": {"const": false}}}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["qualified", "activated"]}}},
      "then": {
        "properties": {
          "blockers": {"maxItems": 0},
          "evidence": {"additionalProperties": {"const": true}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "qualified"}}},
      "then": {"properties": {"workstation": {"properties": {"activated": {"const": false}}}}}
    },
    {
      "if": {"properties": {"status": {"const": "activated"}}},
      "then": {"properties": {"workstation": {"properties": {"activated": {"const": true}}}}}
    }
  ],
  "additionalProperties": false
}
