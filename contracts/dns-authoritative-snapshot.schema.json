{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindclade.com/contracts/dns-authoritative-snapshot.schema.json",
  "title": "Authoritative DNS snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain", "captured_at", "authoritative_nameservers", "parent_ds", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "domain": {"type": "string", "format": "hostname"},
    "captured_at": {"type": "string", "format": "date-time"},
    "authoritative_nameservers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "parent_ds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "records": {"type": "array", "items": {"type": "object", "minProperties": 1}}
  }
}
