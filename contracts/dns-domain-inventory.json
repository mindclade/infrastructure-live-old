{
  "$schema": "./dns-domain-inventory.schema.json",
  "schema_version": 2,
  "registrar": "squarespace",
  "authoritative_dns": "google-cloud-dns",
  "cloud_dns_project_id": "mc-common-dns",
  "environment_naming": {
    "production": "<service>.mindclade.ai",
    "staging": "<service>.staging.mindclade.ai",
    "development": "<service>.dev.mindclade.ai",
    "wildcard_production_records_allowed": false,
    "consumer_alignment_complete": true,
    "hostnames": {
      "production": {
        "ai": ["api.mindclade.ai", "train.mindclade.ai", "models.mindclade.ai"],
        "developer": ["docs.mindclade.dev", "sdk.mindclade.dev", "go.mindclade.dev", "goproxy.mindclade.dev"],
        "studio": ["mindclade.studio"]
      },
      "staging": {
        "ai": ["api.staging.mindclade.ai", "train.staging.mindclade.ai", "models.staging.mindclade.ai"],
        "developer": ["docs.staging.mindclade.dev", "sdk.staging.mindclade.dev", "go.staging.mindclade.dev", "goproxy.staging.mindclade.dev"],
        "studio": ["staging.mindclade.studio"]
      },
      "development": {
        "ai": ["api.dev.mindclade.ai", "train.dev.mindclade.ai", "models.dev.mindclade.ai"],
        "developer": ["docs.dev.mindclade.dev", "sdk.dev.mindclade.dev", "go.dev.mindclade.dev", "goproxy.dev.mindclade.dev"],
        "studio": ["dev.mindclade.studio"]
      }
    }
  },
  "certificate_policy": {
    "owner_repository": "infrastructure-live",
    "service": "google-certificate-manager",
    "scope": "regional-per-project",
    "exact_sans_only": true,
    "wildcard_issuance_allowed": false,
    "permitted_issuers": ["pki.goog", "letsencrypt.org"],
    "incident_contact": "mailto:security@mindclade.com",
    "certificate_names": {
      "ai": "cert-mindclade-ai",
      "developer": "cert-mindclade-dev",
      "studio": "cert-mindclade-studio"
    },
    "dns_authorizations_ready": false,
    "issuer_inventory_complete": false,
    "caa_policy_ready": false
  },
  "migration_window": {
    "status": "unapproved",
    "change_reference": null,
    "starts_at": null,
    "ends_at": null
  },
  "module_contract": {
    "repository": "mindclade/mindclade-internal-monorepo",
    "path": "infra/terraform/modules/dns",
    "certificate_path": "infra/terraform/modules/certificate_manager",
    "ref": "v0.4.0",
    "release_status": "planned",
    "allowed_public_record_types": ["CAA", "MX", "NS", "TXT"],
    "supports_record_name_override": true
  },
  "domains": [
    {
      "domain": "mindclade.com",
      "role": "corporate-identity-email-trust",
      "mail_policy": "google-workspace",
      "certificate_serving": false,
      "dynamic_record_types": [],
      "dnssec_required": true,
      "inventory_complete": false,
      "delegation_ready": false,
      "activation_blockers": [
        "current-authoritative-record-inventory-not-reviewed",
        "workspace-spf-record-absent",
        "workspace-dmarc-record-absent",
        "migration-window-not-approved",
        "dns-module-ref-not-published"
      ],
      "records": [
        {
          "name": "@",
          "type": "MX",
          "ttl": 300,
          "rrdatas": [
            "1 aspmx.l.google.com.",
            "5 alt1.aspmx.l.google.com.",
            "5 alt2.aspmx.l.google.com.",
            "10 alt3.aspmx.l.google.com.",
            "10 alt4.aspmx.l.google.com."
