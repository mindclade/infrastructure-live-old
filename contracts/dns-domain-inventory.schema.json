{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindclade.com/contracts/dns-domain-inventory.schema.json",
  "title": "Mindclade DNS domain inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "registrar", "authoritative_dns", "cloud_dns_project_id", "environment_naming", "certificate_policy", "migration_window", "module_contract", "domains"],
  "properties": {
    "$schema": {"const": "./dns-domain-inventory.schema.json"},
    "schema_version": {"const": 3},
    "registrar": {"const": "squarespace"},
    "authoritative_dns": {"const": "google-cloud-dns"},
    "cloud_dns_project_id": {"const": "mc-common-dns"},
    "environment_naming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production", "staging", "development", "wildcard_production_records_allowed", "consumer_alignment_complete", "hostnames"],
      "properties": {
        "production": {"const": "<service>.mindclade.ai"},
        "staging": {"const": "<service>.staging.mindclade.ai"},
        "development": {"const": "<service>.dev.mindclade.ai"},
        "wildcard_production_records_allowed": {"const": false},
        "consumer_alignment_complete": {"type": "boolean"},
        "hostnames": {
          "type": "object",
          "additionalProperties": false,
          "required": ["production", "staging", "development"],
          "properties": {
            "production": {"$ref": "#/$defs/hostname_groups"},
            "staging": {"$ref": "#/$defs/hostname_groups"},
            "development": {"$ref": "#/$defs/hostname_groups"}
          }
        }
      }
    },
    "certificate_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_repository", "service", "scope", "exact_sans_only", "wildcard_issuance_allowed", "permitted_issuers", "incident_contact", "certificate_names", "dns_authorizations_ready", "issuer_inventory_complete", "caa_policy_ready"],
      "properties": {
        "owner_repository": {"const": "infrastructure-live"},
        "service": {"const": "google-certificate-manager"},
        "scope": {"const": "regional-per-project"},
        "exact_sans_only": {"const": true},
        "wildcard_issuance_allowed": {"const": false},
        "permitted_issuers": {
          "type": "array",
          "items": {"enum": ["pki.goog", "letsencrypt.org"]},
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "incident_contact": {"const": "mailto:security@mindclade.com"},
        "certificate_names": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ai", "developer", "studio"],
          "properties": {
            "ai": {"const": "cert-mindclade-ai"},
            "developer": {"const": "cert-mindclade-dev"},
            "studio": {"const": "cert-mindclade-studio"}
          }
        },
        "dns_authorizations_ready": {"type": "boolean"},
        "issuer_inventory_complete": {"type": "boolean"},
        "caa_policy_ready": {"type": "boolean"}
      }
    },
    "migration_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "change_reference", "starts_at", "ends_at"],
      "properties": {
        "status": {"enum": ["unapproved", "approved"]},
        "change_reference": {"type": ["string", "null"]},
        "starts_at": {"type": ["string", "null"]},
        "ends_at": {"type": ["string", "null"]}
      },
      "oneOf": [
        {
          "properties": {
            "status": {"const": "unapproved"},
            "change_reference": {"type": "null"},
            "starts_at": {"type": "null"},
            "ends_at": {"type": "null"}
          }
        },
        {
          "properties": {
            "status": {"const": "approved"},
            "change_reference": {"type": "string", "pattern": "^(CHG|INC|SEC|DR)-[A-Za-z0-9][A-Za-z0-9._-]*$"},
            "starts_at": {"type": "string", "format": "date-time"},
            "ends_at": {"type": "string", "format": "date-time"}
          }
        }
      ]
    },
    "module_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "certificate_path", "ref", "release_status", "allowed_public_record_types", "conditionally_allowed_public_record_types", "supports_record_name_override"],
      "properties": {
        "repository": {"const": "mindclade/mindclade-internal-monorepo"},
        "path": {"const": "infra/terraform/modules/dns"},
        "certificate_path": {"const": "infra/terraform/modules/certificate_manager"},
        "ref": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "release_status": {"enum": ["planned", "published"]},
        "allowed_public_record_types": {"type": "array", "items": {"enum": ["CAA", "MX", "NS", "TXT"]}, "minItems": 4, "maxItems": 4, "uniqueItems": true},
        "conditionally_allowed_public_record_types": {"type": "array", "items": {"enum": ["A", "AAAA", "CNAME"]}, "minItems": 3, "maxItems": 3, "uniqueItems": true},
        "supports_record_name_override": {"type": "boolean"}
      }
    },
    "domains": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/domain"}
    }
  },
  "$defs": {
    "hostname": {
      "type": "string",
      "format": "hostname",
      "maxLength": 253
    },
    "hostname_list": {
      "type": "array",
      "items": {"$ref": "#/$defs/hostname"},
      "minItems": 1,
      "uniqueItems": true
    },
    "hostname_groups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ai", "developer", "studio"],
      "properties": {
        "ai": {"$ref": "#/$defs/hostname_list"},
        "developer": {"$ref": "#/$defs/hostname_list"},
        "studio": {"$ref": "#/$defs/hostname_list"}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "ttl", "rrdatas"],
      "properties": {
        "name": {"type": "string", "pattern": "^(?:@|[A-Za-z0-9_](?:[A-Za-z0-9_-]{0,61}[A-Za-z0-9_])?(?:\\.[A-Za-z0-9_](?:[A-Za-z0-9_-]{0,61}[A-Za-z0-9_])?)*)$"},
        "type": {"enum": ["A", "AAAA", "CAA", "CNAME", "MX", "NS", "TXT"]},
        "ttl": {"type": "integer", "minimum": 30, "maximum": 86400},
        "rrdatas": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "role", "mail_policy", "certificate_serving", "dynamic_record_types", "public_record_allowlist", "dnssec_required", "inventory_complete", "delegation_ready", "activation_blockers", "records"],
      "properties": {
        "domain": {"enum": ["mindclade.com", "mindclade.ai", "mindclade.dev", "mindclade.studio"]},
        "role": {"type": "string", "minLength": 1},
        "mail_policy": {"enum": ["google-workspace", "no-mail"]},
        "certificate_serving": {"type": "boolean"},
        "dynamic_record_types": {"type": "array", "items": {"const": "CNAME"}, "maxItems": 1, "uniqueItems": true},
        "public_record_allowlist": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "uniqueItems": true},
        "dnssec_required": {"const": true},
        "inventory_complete": {"type": "boolean"},
        "delegation_ready": {"type": "boolean"},
        "activation_blockers": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "uniqueItems": true},
        "records": {"type": "array", "items": {"$ref": "#/$defs/record"}, "minItems": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"domain": {"const": "mindclade.com"}}, "required": ["domain"]},
          "then": {
            "properties": {
              "role": {"const": "corporate-identity-email-trust"},
              "mail_policy": {"const": "google-workspace"},
              "certificate_serving": {"const": false},
              "dynamic_record_types": {"maxItems": 0},
              "public_record_allowlist": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"domain": {"const": "mindclade.ai"}}, "required": ["domain"]},
          "then": {
            "allOf": [
              {"$ref": "#/$defs/public_squarespace_domain"},
              {"properties": {"role": {"const": "production-product-api-auth"}}}
            ]
          }
        },
        {
          "if": {"properties": {"domain": {"const": "mindclade.dev"}}, "required": ["domain"]},
          "then": {
            "allOf": [
              {"$ref": "#/$defs/public_squarespace_domain"},
              {"properties": {"role": {"const": "developer-documentation-sdks"}}}
            ]
          }
        },
        {
          "if": {"properties": {"domain": {"const": "mindclade.studio"}}, "required": ["domain"]},
          "then": {
            "properties": {
              "role": {"const": "isolated-demos-experiments"},
              "mail_policy": {"const": "no-mail"},
              "certificate_serving": {"const": true},
              "dynamic_record_types": {"prefixItems": [{"const": "CNAME"}], "minItems": 1, "maxItems": 1},
              "public_record_allowlist": {"maxItems": 0}
            }
          }
        }
      ]
    },
    "public_squarespace_domain": {
      "properties": {
        "mail_policy": {"const": "no-mail"},
        "certificate_serving": {"const": true},
        "dynamic_record_types": {"prefixItems": [{"const": "CNAME"}], "minItems": 1, "maxItems": 1},
        "public_record_allowlist": {"prefixItems": [{"const": "apex-a"}, {"const": "www-cname"}], "minItems": 2, "maxItems": 2}
      }
    }
  }
}
