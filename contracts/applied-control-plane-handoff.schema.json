{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mindclade applied infrastructure control-plane handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "producer",
    "source_commit",
    "environment",
    "source_units",
    "variables",
    "credential_material_included"
  ],
  "properties": {
    "contract_version": { "const": "1.4.0" },
    "producer": { "const": "mindclade/infrastructure-live" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "environment": { "const": "production" },
    "source_units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automation_iam",
        "gitops_identities",
        "binary_authorization",
        "qualification_evidence"
      ],
      "properties": {
        "automation_iam": { "const": "1-org/automation-iam" },
        "gitops_identities": { "const": "5-workloads/shared/control-plane-identities" },
        "binary_authorization": { "const": "5-workloads/production/binary-authorization" },
        "qualification_evidence": { "const": "5-workloads/shared/production-qualification-evidence" }
      }
    },
    "variables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "CI_PROJECT_ID",
        "WIF_PROVIDER_BAZEL_CACHE",
        "SA_BAZEL_CACHE_READER",
        "SA_BAZEL_CACHE_WRITER",
        "SA_ARC_CANARY",
        "SA_ARTIFACT_BUILDER",
        "SA_ARTIFACT_QUALIFICATION_READER",
        "SA_ARTIFACT_QUALIFIER",
        "SA_ARTIFACT_SIGNER",
        "SA_ARTIFACT_PROMOTER",
        "SA_GITOPS_RENDER",
        "SA_GITOPS_VERIFIER",
        "WIF_PROVIDER_PRODUCTION_QUALIFICATION",
        "SA_PRODUCTION_QUALIFICATION_EVALUATOR",
        "SA_PRODUCTION_QUALIFICATION_READER",
        "SA_PRODUCTION_QUALIFICATION_WRITER",
        "PRODUCTION_QUALIFICATION_PROJECT",
        "PRODUCTION_QUALIFICATION_BUCKET",
        "PRODUCTION_QUALIFICATION_PRIVATE_KEY_SECRET",
        "PRODUCTION_ELIGIBILITY_SIGNING_KEY_ID",
        "PRODUCTION_ELIGIBILITY_KMS_KEY_VERSION",
        "BINAUTHZ_BUILD_ATTESTOR_PROJECT",
        "BINAUTHZ_BUILD_ATTESTOR",
        "BINAUTHZ_QUALIFICATION_ATTESTOR_PROJECT",
        "BINAUTHZ_QUALIFICATION_ATTESTOR",
        "BINAUTHZ_DEPLOYMENT_ATTESTOR_PROJECT",
        "BINAUTHZ_DEPLOYMENT_ATTESTOR",
        "BINAUTHZ_DEPLOYMENT_ATTESTOR_KEY_VERSION"
      ],
      "properties": {
        "CI_PROJECT_ID": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*-common-ci$"
        },
        "WIF_PROVIDER_BAZEL_CACHE": {
          "type": "string",
          "pattern": "^projects/[0-9]+/locations/global/workloadIdentityPools/github/providers/gh-bazel-cache$"
        },
        "SA_BAZEL_CACHE_READER": {
          "type": "string",
          "pattern": "^bazel-cache-reader@[a-z][a-z0-9-]*-common-ci\\.iam\\.gserviceaccount\\.com$"
        },
        "SA_BAZEL_CACHE_WRITER": {
          "type": "string",
          "pattern": "^bazel-cache-writer@[a-z][a-z0-9-]*-common-ci\\.iam\\.gserviceaccount\\.com$"
        },
        "SA_ARC_CANARY": {
          "type": "string",
          "pattern": "^sa-arc-canary@[a-z][a-z0-9-]*-common-ci\\.iam\\.gserviceaccount\\.com$"
        },
        "SA_ARTIFACT_BUILDER": {
          "type": "string",
          "pattern": "^sa-artifact-builder@[a-z][a-z0-9-]*-common-ci\\.iam\\.gserviceaccount\\.com$"
        },
        "SA_ARTIFACT_QUALIFICATION_READER": {
          "type": "string",
          "pattern": "^sa-artifact-qual-reader@[a-z][a-z0-9-]*-common-ci\\.iam\\.gserviceaccount\\.com$"
        },
        "SA_ARTIFACT_QUALIFIER": {
          "type": "string",
          "pattern": "^sa-artifact-qualifier@[a-z][a-z0-9-]*-common-ci\\.iam\\.gserviceaccount\\.com$"
        },
        "SA_ARTIFACT_SIGNER": {
          "type": "string",
          "pattern": "^sa-artifact-signer@[a-z][a-z0-9-]*-common-ci\\.iam\\.gserviceaccount\\.com$"
        },
        "SA_ARTIFACT_PROMOTER": {
          "type": "string",
          "pattern": "^sa-artifact-promoter@[a-z][a-z0-9-]*-common-ci\\.iam\\.gserviceaccount\\.com$"
        },
        "SA_GITOPS_RENDER": {
          "type": "string",
          "pattern": "^sa-gitops-render@[a-z][a-z0-9-]*-common-security\\.iam\\.gserviceaccount\\.com$"
        },
        "SA_GITOPS_VERIFIER": {
          "type": "string",
          "pattern": "^sa-gitops-verifier@[a-z][a-z0-9-]*-common-security\\.iam\\.gserviceaccount\\.com$"
        },
        "WIF_PROVIDER_PRODUCTION_QUALIFICATION": {
          "type": "string",
          "pattern": "^projects/[0-9]+/locations/global/workloadIdentityPools/github/providers/gh-production-qualification$"
        },
        "SA_PRODUCTION_QUALIFICATION_EVALUATOR": {
          "const": "sa-prod-qual-evaluator@mc-common-security.iam.gserviceaccount.com"
        },
        "SA_PRODUCTION_QUALIFICATION_READER": {
          "const": "sa-prod-qual-reader@mc-common-security.iam.gserviceaccount.com"
        },
        "SA_PRODUCTION_QUALIFICATION_WRITER": {
          "const": "sa-prod-qual-writer@mc-common-security.iam.gserviceaccount.com"
        },
        "PRODUCTION_QUALIFICATION_PROJECT": { "const": "mc-common-security" },
        "PRODUCTION_QUALIFICATION_BUCKET": { "const": "mc-production-qualification-evidence" },
        "PRODUCTION_QUALIFICATION_PRIVATE_KEY_SECRET": {
          "const": "github-app-production-qualification-reader-pem"
        },
        "PRODUCTION_ELIGIBILITY_SIGNING_KEY_ID": {
          "const": "production-eligibility-v1"
        },
        "PRODUCTION_ELIGIBILITY_KMS_KEY_VERSION": {
          "type": "string",
          "pattern": "^projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/locations/[a-z0-9-]+/keyRings/[A-Za-z0-9_-]+/cryptoKeys/production-eligibility-decisions/cryptoKeyVersions/[1-9][0-9]*$"
        },
        "BINAUTHZ_BUILD_ATTESTOR_PROJECT": { "$ref": "#/$defs/productionProjectId" },
        "BINAUTHZ_BUILD_ATTESTOR": { "const": "build-attestor" },
        "BINAUTHZ_QUALIFICATION_ATTESTOR_PROJECT": { "$ref": "#/$defs/productionProjectId" },
        "BINAUTHZ_QUALIFICATION_ATTESTOR": { "const": "qualification-attestor" },
        "BINAUTHZ_DEPLOYMENT_ATTESTOR_PROJECT": { "$ref": "#/$defs/productionProjectId" },
        "BINAUTHZ_DEPLOYMENT_ATTESTOR": { "const": "deployment-attestor" },
        "BINAUTHZ_DEPLOYMENT_ATTESTOR_KEY_VERSION": {
          "type": "string",
          "pattern": "^projects/[a-z][a-z0-9-]{4,28}[a-z0-9]/locations/[a-z0-9-]+/keyRings/[A-Za-z0-9_-]+/cryptoKeys/attestor-deployment-attestor/cryptoKeyVersions/[1-9][0-9]*$"
        }
      }
    },
    "credential_material_included": {
      "const": false
    }
  },
  "$defs": {
    "productionProjectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*-production-platform$"
    }
  }
}
